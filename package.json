{
  "name": "qr-generator",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky",
    "release:patch": "pnpm version patch -m \"chore(release): v%s\" && git push --follow-tags",
    "release:minor": "pnpm version minor -m \"chore(release): v%s\" && git push --follow-tags",
    "release:major": "pnpm version major -m \"chore(release): v%s\" && git push --follow-tags"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "lucide-react": "^0.525.0",
    "mp4-muxer": "^5.2.2",
    "qrcode-generator": "^1.4.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
